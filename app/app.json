{
  "expo": {
    "name": "Houlalah",
    "slug": "houlalah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.houlalah.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1114",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.houlalah.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "houlalah",
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A1114"
        }
      ],
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Houlalah utilise votre position seulement quand vous touchez « Me localiser », pour centrer la carte et montrer les spots autour de vous."
        }
      ]
    ]
  }
}
